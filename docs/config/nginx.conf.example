# Merge this server block into your Nginx http block.
# Change server_name, root and the backend address for your deployment.
server {
    listen 80;
    server_name localhost;
    root /srv/zhiguang/frontend/dist;
    index index.html;
    client_max_body_size 8m;

    location / {
        try_files $uri $uri/ /index.html;
    }

    location /api/ {
        # No URI suffix: retain the original /api/v1/... request path.
        proxy_pass http://127.0.0.1:8080;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Connection "";
        # Required for streamed RAG answers to reach the browser progressively.
        proxy_buffering off;
        proxy_cache off;
        proxy_read_timeout 120s;
    }
}
